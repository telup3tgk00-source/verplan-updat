{
  "manifest_version": 3,
  "name": "METRIK Auto-Sync",
  "version": "1.0",
  "description": "Otomatis sinkronisasi cookie dari portal ACMT ke sistem METRIK.",
  "permissions": [
    "cookies",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "*://portalapp.iconpln.co.id/*",
    "*://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "METRIK Auto-Sync"
  }
}
